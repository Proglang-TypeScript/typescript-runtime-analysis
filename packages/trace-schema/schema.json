{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/typescript-runtime-analysis/v1",
  "definitions": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "line", "column"],
      "properties": {"file":{"type":"string"},"line":{"type":"integer","minimum":1},"column":{"type":"integer","minimum":1}}
    },
    "shallowType": {"enum":["undefined","null","boolean","number","string","bigint","symbol","object","array","function","unknown"]},
    "provenance": {
      "type":"object", "additionalProperties":false,
      "required":["package","version","repository","commit","evidence","entryPoint","publicModule","backend","backendVersion","executionId"],
      "properties": {
        "package":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"repository":{"type":"string"},
        "commit":{"type":"string"},"evidence":{"enum":["README","test","client","fixture"]},"entryPoint":{"type":"string"},
        "publicModule":{"type":"string"},"backend":{"type":"string"},"backendVersion":{"type":"string"},"executionId":{"type":"string"}
      }
    },
    "observation": {
      "type":"object", "additionalProperties":false,
      "required":["functionId","functionName","position","index","type","source","executionId","order","public","interaction"],
      "properties": {
        "functionId":{"type":"string"},"functionName":{"type":"string"},"position":{"enum":["parameter","result"]},
        "index":{"type":"integer","minimum":-1},"type":{"$ref":"#/definitions/shallowType"},"source":{"$ref":"#/definitions/source"},
        "executionId":{"type":"string"},"order":{"type":"integer","minimum":0},"public":{"type":"boolean"},
        "interaction":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string"}},"additionalProperties":true}
      }
    },
    "operatorObservation": {
      "type":"object", "additionalProperties":false,
      "required":["operator","source","leftType","rightType","executionId","order"],
      "properties":{"operator":{"type":"string"},"source":{"$ref":"#/definitions/source"},"leftType":{"$ref":"#/definitions/shallowType"},"rightType":{"$ref":"#/definitions/shallowType"},"executionId":{"type":"string"},"order":{"type":"integer","minimum":0}}
    },
    "trace": {
      "type":"object", "additionalProperties":false,
      "required":["schemaVersion","provenance","observations","operators"],
      "properties":{"schemaVersion":{"const":1},"provenance":{"$ref":"#/definitions/provenance"},"observations":{"type":"array","items":{"$ref":"#/definitions/observation"}},"operators":{"type":"array","items":{"$ref":"#/definitions/operatorObservation"}}}
    },
    "diagnostic": {
      "type":"object", "additionalProperties":false, "required":["code","message"],
      "properties":{"code":{"type":"string"},"message":{"type":"string"},"functionId":{"type":"string"},"reason":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}}
    },
    "declaration": {
      "type":"object", "additionalProperties":false, "required":["schemaVersion","module","text","provenance","diagnostics"],
      "properties":{"schemaVersion":{"const":1},"module":{"type":"string"},"text":{"type":"string"},"provenance":{"type":"array","items":{"$ref":"#/definitions/provenance"}},"diagnostics":{"type":"array","items":{"$ref":"#/definitions/diagnostic"}}}
    },
    "pattern": {
      "type":"object", "additionalProperties":false,
      "required":["schemaVersion","abstraction","package","version","source","patternId","variables","occurrences","packageCount"],
      "properties":{"schemaVersion":{"const":1},"abstraction":{"const":"binary-shallow-v1"},"package":{"type":"string"},"version":{"type":"string"},"source":{"$ref":"#/definitions/source"},"patternId":{"type":"string"},"variables":{"type":"array","items":{"enum":["left","right"]}},"occurrences":{"type":"integer","minimum":1},"packageCount":{"type":"integer","minimum":1}}
    },
    "distribution": {
      "type":"object", "additionalProperties":false,
      "required":["schemaVersion","abstraction","patternId","position","counts","packageCount","occurrences"],
      "properties":{"schemaVersion":{"const":1},"abstraction":{"const":"binary-shallow-v1"},"patternId":{"type":"string"},"position":{"enum":["left","right"]},"counts":{"type":"object","propertyNames":{"$ref":"#/definitions/shallowType"},"additionalProperties":{"type":"integer","minimum":1}},"packageCount":{"type":"integer","minimum":1},"occurrences":{"type":"integer","minimum":1}}
    }
  }
}
